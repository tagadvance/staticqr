{
  "name": "static-qr",
  "version": "2.0.0",
  "private": true,
  "description": "A QR code generator that runs entirely in your browser and never sends your data anywhere",
  "homepage": "https://staticqr.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/tagadvance/static-qr.git"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "images": "node tools/images.mjs",
    "golden": "node tools/golden.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "test": "node --test test/",
    "serve": "node tools/serve.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "jsqr": "^1.4.0"
  }
}
